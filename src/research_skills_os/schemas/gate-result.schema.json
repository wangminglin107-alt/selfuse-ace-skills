    },
    "findings": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Findings",
      "type": "array"
    },
    "gate_id": {
      "minLength": 1,
      "title": "Gate Id",
      "type": "string"
    },
    "gate_version": {
      "minLength": 1,
      "title": "Gate Version",
      "type": "string"
    },
    "remediation": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "title": "Remediation",
      "type": "array"
    },
    "severity": {
