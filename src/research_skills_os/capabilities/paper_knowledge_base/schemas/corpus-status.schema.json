{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-skills-os.local/schemas/corpus-status/1.0",
  "title": "Corpus Status",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_hashes", "unresolved_duplicate_groups", "privacy_declared", "coverage_limits"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "unresolved_duplicate_groups": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "string", "minLength": 1}}
    },
    "privacy_declared": {"type": "boolean"},
    "coverage_limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
