{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-skills-os.local/schemas/construct-map/1.0",
  "title": "Construct Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "known_evidence_row_ids", "material_contradiction_ids", "constructs", "relations"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "known_evidence_row_ids": {"type": "array", "items": {"type": "string"}},
    "material_contradiction_ids": {"type": "array", "items": {"type": "string"}},
    "constructs": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["construct_id", "label", "definition", "level_of_analysis", "evidence_row_ids"]}},
    "relations": {"type": "array", "items": {"type": "object", "required": ["from_construct_id", "to_construct_id", "mechanism", "evidence_row_ids", "cross_level_rationale"]}}
  }
}
