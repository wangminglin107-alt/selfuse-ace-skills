{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-skills-os.local/schemas/document-index/1.0",
  "title": "Document Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "documents"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "title", "authors", "identifiers", "artifact_id", "path",
          "artifact_sha256", "imported_at", "document_type", "language", "access_state",
          "privacy_label", "content_availability", "locators", "extraction_method",
          "extraction_warnings", "version_state", "supersedes_source_id",
          "superseded_by_source_id", "metadata_verification"
        ],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "identifiers": {"type": "object", "additionalProperties": {"type": "string"}},
          "artifact_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "imported_at": {"type": "string", "format": "date-time"},
          "document_type": {"enum": ["article", "book", "chapter", "thesis", "report", "dataset", "policy", "web", "other"]},
          "language": {"type": "string", "minLength": 1},
          "access_state": {"enum": ["full_text", "abstract_only", "metadata_only", "unavailable"]},
          "privacy_label": {"enum": ["public", "project_private", "restricted", null]},
          "content_availability": {"enum": ["full_text", "abstract_only", "metadata_only", "unavailable"]},
          "locators": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["page", "section", "block_id", "content_sha256"],
              "properties": {
                "page": {"type": ["integer", "null"], "minimum": 1},
                "section": {"type": ["string", "null"], "minLength": 1},
                "block_id": {"type": "string", "minLength": 1},
                "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              },
              "anyOf": [{"required": ["page"]}, {"required": ["section"]}]
            }
          },
          "extraction_method": {"type": "string", "minLength": 1},
          "extraction_warnings": {"type": "array", "items": {"type": "string"}},
          "version_state": {"enum": ["current", "superseded"]},
          "supersedes_source_id": {"type": ["string", "null"]},
          "superseded_by_source_id": {"type": ["string", "null"]},
          "metadata_verification": {"enum": ["verified", "mismatch", "not_found", "suspicious", "manual_needed"]}
        }
      }
    }
  }
}
